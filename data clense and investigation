----------------------------------------------------------------------------------------------------
----Check for nulls, n/a , or blanks
----------------------------------------------------------------------------------------------------

SELECT
    'adjust_raw_data' AS table_name,
    COUNT(*) FILTER (
        WHERE campaign IS NULL OR UPPER(TRIM(campaign)) IN ('N/A', '')
    ) AS campaign_missing,
    COUNT(*) FILTER (
        WHERE adset IS NULL OR UPPER(TRIM(adset)) IN ('N/A', '')
    ) AS adset_missing,
    COUNT(*) FILTER (
        WHERE ad IS NULL OR UPPER(TRIM(ad)) IN ('N/A', '')
    ) AS ad_missing
FROM adjust_raw_data

UNION ALL

SELECT
    'meta_raw_data' AS table_name,
    COUNT(*) FILTER (
        WHERE campaign IS NULL OR UPPER(TRIM(campaign)) IN ('N/A', '')
    ) AS campaign_missing,
    COUNT(*) FILTER (
        WHERE adset IS NULL OR UPPER(TRIM(adset)) IN ('N/A', '')
    ) AS adset_missing,
    COUNT(*) FILTER (
        WHERE ad IS NULL OR UPPER(TRIM(ad)) IN ('N/A', '')
    ) AS ad_missing
FROM meta_raw_data;



------------------------------------------------------------------------------------------------------------
---% of zero spend, clicks etc
------------------------------------------------------------------------------------------------------------

SELECT
    COUNT(*) AS total_rows,
    COUNT(*) FILTER (WHERE spend = 0) AS zero_spend_rows,
    ROUND(
        100.0 * COUNT(*) FILTER (WHERE spend = 0)
        / NULLIF(COUNT(*), 0),
        2
    ) AS pct_zero_spend,
    COUNT(*) FILTER (WHERE impressions = 0) AS zero_impressions_rows,
    ROUND(
        100.0 * COUNT(*) FILTER (WHERE impressions = 0)
        / NULLIF(COUNT(*), 0),
        2
    ) AS pct_zero_imp,
    COUNT(*) FILTER (WHERE clicks = 0) AS zero_clicks_rows,
      ROUND(
        100.0 * COUNT(*) FILTER (WHERE clicks = 0)
        / NULLIF(COUNT(*), 0),
        2
    ) AS pct_zero_clicks,
  COUNT(*) FILTER (WHERE d0_purchase_revenue = 0) AS d0_purchase_revenue,
  ROUND(
        100.0 * COUNT(*) FILTER (WHERE d0_purchase_revenue = 0)
        / NULLIF(COUNT(*), 0),
        2
    ) AS  pct_d0_purchase_revenue,
  COUNT(*) FILTER (WHERE d0_purchase_revenue = 0) AS d30_purchase_revenue,
  ROUND(
        100.0 * COUNT(*) FILTER (WHERE d30_purchase_revenue = 0)
        / NULLIF(COUNT(*), 0),
        2
    ) AS  pct_d30_purchase_revenue
    
FROM adjust_raw_data;



