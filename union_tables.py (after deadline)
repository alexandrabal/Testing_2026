import pandas as pd

# =====================================================================
# DATA CLEANSING: raw Adjust + Meta files -> adjust_clean.csv, meta_clean.csv
# Every step is logged to an audit table (rows + spend) so nothing is lost silently.
# =====================================================================

ADJUST_PATH = "/content/sample_data/Adjust raw data - Adjust raw data.csv"
META_PATH = "/content/sample_data/Meta raw data.csv"

DROP_EXACT_DUPLICATES = False   # set True to drop exact duplicate rows (spend > 0)

# ---------- LOAD (everything as text first, so nothing is silently coerced) ----------
adjust = pd.read_csv(ADJUST_PATH, dtype=str)
meta = pd.read_csv(META_PATH, dtype=str)

# ---------- AUDIT HELPERS ----------
audit = []


def to_num(s):
    return pd.to_numeric(
        s.astype(str).str.strip().str.strip('"').str.replace(",", "", regex=False),
        errors="coerce",
    )


def log(step, source, df):
    spend = to_num(df["spend"]).fillna(0).sum() if "spend" in df.columns else float("nan")
    audit.append({"step": step, "source": source, "rows": len(df), "spend": round(spend, 2)})


log("1 raw", "adjust", adjust)
log("1 raw", "meta", meta)

# ---------- STEP 2: STRIP QUOTES / WHITESPACE FROM ALL TEXT ----------
for df in (adjust, meta):
    for col in df.columns:
        df[col] = df[col].astype(str).str.strip().str.strip('"').str.strip()
        df[col] = df[col].replace({"nan": pd.NA, "None": pd.NA, "": pd.NA})

# ---------- STEP 3: DATES ----------
# format="mixed" copes with mixed date formats; unparseable dates become NaT and are reported
for name, df in (("adjust", adjust), ("meta", meta)):
    parsed = pd.to_datetime(df["date"], format="mixed", errors="coerce")
    print(name, "unparseable dates:", int(parsed.isna().sum()))
    df["date"] = parsed.dt.date

adjust = adjust[adjust["date"].notna()].copy()
meta = meta[meta["date"].notna()].copy()
log("3 valid dates", "adjust", adjust)
log("3 valid dates", "meta", meta)

# ---------- STEP 4: NUMERIC COLUMNS (commas/quotes removed, bad values -> 0) ----------
ADJUST_NUM = ["spend", "impressions", "clicks", "installs", "purchases",
              "purchase_revenue", "d0_purchase_revenue", "d30_purchase_revenue"]
META_NUM = ["spend", "impressions", "clicks"]

for df, cols in ((adjust, ADJUST_NUM), (meta, META_NUM)):
    for c in cols:
        if c in df.columns:
            df[c] = to_num(df[c]).fillna(0)

# ---------- STEP 5: BLANK / N/A DIMENSIONS -> 'Uncategorised' ----------
for name, df in (("adjust", adjust), ("meta", meta)):
    for col in ["campaign", "adset", "ad", "country"]:
        if col in df.columns:
            blank = df[col].isna() | df[col].astype(str).str.strip().str.upper().isin(["N/A", "NA", "NULL", ""])
            print(name, col, "blank / N/A:", int(blank.sum()))
            df.loc[blank, col] = "Uncategorised"

# ---------- STEP 6: COUNTRY MAPPING + FILTER (US, Canada, Australia) ----------
country_map = pd.DataFrame(
    [
        ("US", "United States", "US"),
        ("USA", "United States", "US"),
        ("UNITED STATES", "United States", "US"),
        ("UNITED STATES OF AMERICA", "United States", "US"),
        ("CA", "Canada", "CA"),
        ("CAN", "Canada", "CA"),
        ("CANADA", "Canada", "CA"),
        ("AU", "Australia", "AU"),
        ("AUS", "Australia", "AU"),
        ("AUSTRALIA", "Australia", "AU"),
    ],
    columns=["raw_value", "country", "country_code"],
)


def map_country(df, name):
    df = df.copy()
    df["raw_value"] = df["country"].astype(str).str.strip().str.upper()
    mapped = df.drop(columns=["country"]).merge(country_map, on="raw_value", how="inner")
    dropped = df.loc[~df["raw_value"].isin(country_map["raw_value"]), "country"].unique()
    print(name, "countries dropped:", sorted(map(str, dropped)))
    return mapped.drop(columns=["raw_value"])


adjust = map_country(adjust, "adjust")
meta = map_country(meta, "meta")
log("6 country filter (US/CA/AU)", "adjust", adjust)
log("6 country filter (US/CA/AU)", "meta", meta)

# ---------- STEP 7: REMOVE ADWORDS (Adjust only) ----------
adwords_mask = adjust["partner"].astype(str).str.contains("adwords", case=False, na=False)
print("adjust adwords rows removed:", int(adwords_mask.sum()))
adjust = adjust[~adwords_mask].copy()
log("7 adwords removed", "adjust", adjust)
log("7 adwords removed", "meta", meta)

# ---------- STEP 8: CLEANSED CAMPAIGN ID ----------
# Adjust: substring(campaign from '[(]([0-9]+)[)]')
adjust["campaign_id"] = adjust["campaign"].astype(str).str.extract(r"[(]([0-9]+)[)]")[0]
# Meta: trim(split_part(campaign, '|', 1))
meta["campaign_id"] = meta["campaign"].astype(str).str.split("|").str.get(0).str.strip()

adjust["campaign_id"] = adjust["campaign_id"].astype(object).fillna("Uncategorised")
meta["campaign_id"] = meta["campaign_id"].astype(object).fillna("Uncategorised")

a_ids, m_ids = set(adjust["campaign_id"]), set(meta["campaign_id"])
print("campaign_id -> adjust:", len(a_ids), "| meta:", len(m_ids), "| matched:", len(a_ids & m_ids))

# ---------- STEP 9: META OS FROM CAMPAIGN NAME, PARTNER ----------
def get_os(campaign):
    c = str(campaign).lower()
    if "android" in c:
        return "android"
    if "ios" in c:
        return "ios"
    return "Uncategorised"


meta["os"] = meta["campaign"].apply(get_os)
meta["partner"] = "facebook"

# ---------- STEP 10: EXACT DUPLICATES ----------
for name, df in (("adjust", adjust), ("meta", meta)):
    dupes = int(df[df["spend"] > 0].duplicated().sum())
    print(name, "exact duplicate rows (spend > 0):", dupes)

if DROP_EXACT_DUPLICATES:
    adjust = adjust.drop_duplicates().copy()
    meta = meta.drop_duplicates().copy()
    log("10 duplicates removed", "adjust", adjust)
    log("10 duplicates removed", "meta", meta)

# ---------- AUDIT OUTPUT ----------
audit_df = pd.DataFrame(audit)
print("\nAUDIT TRAIL")
print(audit_df.to_string(index=False))

lost = audit_df.pivot(index="step", columns="source", values="spend")
lost["adjust_spend_lost"] = -lost["adjust"].diff()
lost["meta_spend_lost"] = -lost["meta"].diff()
print("\nSPEND LOST PER STEP")
print(lost)

# ---------- SAVE ----------
adjust.to_csv("adjust_clean.csv", index=False)
meta.to_csv("meta_clean.csv", index=False)
audit_df.to_csv("cleansing_audit.csv", index=False)
print("\nSaved: adjust_clean.csv", adjust.shape, "| meta_clean.csv", meta.shape, "| cleansing_audit.csv")

try:
    from google.colab import files
    for f in ["adjust_clean.csv", "meta_clean.csv", "cleansing_audit.csv"]:
        files.download(f)
except ImportError:
    pass
